# Copy to .env (local) or set these as environment variables on Railway.

# Port the server listens on (Railway sets PORT automatically).
PORT=3000

# AI question generation (https://console.anthropic.com). Optional — falls back
# to the offline question bank if missing.
ANTHROPIC_API_KEY=

# Fast Money voice transcription (optional). Pick a provider + matching key.
# Groq has a free Whisper tier: https://console.groq.com/keys
STT_PROVIDER=groq
GROQ_API_KEY=
# Or use OpenAI: set STT_PROVIDER=openai and provide:
# OPENAI_API_KEY=

# Optional: override the question-generation model (default claude-sonnet-4-6)
# AI_MODEL=claude-sonnet-4-6
